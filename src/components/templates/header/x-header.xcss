@import '../../../styles/global.xcss';

@header-height: 74px;

header {
    background-color: @white;
    border-radius: @space-lg;
    box-shadow: @strong-shadow;
    width: auto;
    padding: 0 @space-sm;
    position: sticky;
    top: @space-md;
    z-index: 1;

    .header-container { 
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        height: @header-height;
        gap: @space-xl;
        
        .logo {
            height: 60px;
            margin: 0;
            display: block;
        }
    }
}

.nav-links {
    display: flex;
    gap: @space-lg;
    list-style: none;
    align-items: center;
    margin-right: @space-lg;
}
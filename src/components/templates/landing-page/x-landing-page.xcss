@import '../../../styles/global.xcss';

// Center the content
center {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 80vh;
    color: @text-500;
    width: 100%;
    box-sizing: border-box;
    padding: 2rem 1rem;

    @media (max-width: 900px) {
        padding: 1rem 0.5rem;
    }
}

// Headings
h1, h2, h3 {
    margin-bottom: 1rem;
}
h1 {
    font-size: 2.5rem;
    font-weight: bold;
    color: @accent-500;
}
h2 {
    font-size: 1.5rem;
    margin-bottom: 2rem;
    color: @text-400;
}
h3 {
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
    color: @accent-400;
}

// Action buttons
.action-buttons {
    display: flex;
    gap: 1rem;

    > button {
        .default-submit-button();
        padding: 15px;
    }
}

// Image container
.img-container {
    display: flex;
    gap: 1rem;
    margin: 2rem 0;
    justify-content: center;
    flex-wrap: wrap;

    img {
        width: 50vw;
        height: 50vh;
        object-fit: cover;
        border-radius: 12px;
        box-shadow: 0 2px 12px @dark-200;
        background: @accent-100;
    }

    @media (max-width: 900px) {
        flex-direction: column;
        align-items: center;
        gap: 1rem;
    }
}

// Features section
.features {
    display: flex;
    gap: 2rem;
    margin-top: 2rem;
    justify-content: center;
    flex-wrap: wrap;
    width: 90%;

    @media (max-width: 900px) {
        flex-direction: column;
        align-items: center;
        gap: 1.5rem;
    }

    .feature {
        background: @accent-100;
        border-radius: 8px;
        padding: 1.5rem;
        flex: 1 1 0;
        min-width: 220px;
        max-width: 100%;
        box-shadow: 0 1px 8px @dark-100;
        color: @text-500;
        text-align: left;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        box-sizing: border-box;
        margin: 0;

        h3 {
            margin-top: 0;
        }
        p {
            margin-bottom: 0;
            color: @text-400;
        }

        @media (max-width: 900px) {
            width: 90vw;
            max-width: 400px;
        }
    }
}

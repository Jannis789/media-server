<!DOCTYPE html>

<div class="register-form-container">
    <form class="register-form">
        <h2>Registration</h2>
        <hr>
        
        <div class="input-box">
            <x-icon class="left-symbolic" name="system-users-symbolic"></x-icon>
            <input type="text" placeholder="Username" required />
        </div>

        <div class="input-box">
            <x-icon class="left-symbolic" name="mail-symbolic"></x-icon>
            <input type="email" placeholder="Email" required />
        </div>

        <div class="input-box">
            <x-icon class="left-symbolic" name="password-symbolic"></x-icon>

            <input :type="revealPassword ? 'text' : 'password'" placeholder="Password" required />
        
            <template x-if="!revealPassword">
                <x-icon class="right-symbolic" name="view-conceal-symbolic" @click="revealPassword = true"></x-icon>
            </template>
        
            <template x-if="revealPassword">
                <x-icon class="right-symbolic" name="view-reveal-symbolic" @click="revealPassword = false"></x-icon>
            </template>
        </div>


        <div class="input-box">
            <x-icon class="left-symbolic" name="password-symbolic"></x-icon>
            
            <input :type="revealConfirmPassword ? 'text' : 'password'" placeholder="Password" required />
        
            <template x-if="!revealConfirmPassword">
                <x-icon class="right-symbolic" name="view-conceal-symbolic" @click="revealConfirmPassword = true"></x-icon>
            </template>
        
            <template x-if="revealConfirmPassword">
                <x-icon class="right-symbolic" name="view-reveal-symbolic" @click="revealConfirmPassword = false"></x-icon>
            </template>
        </div>
        
        <div class="remember">
            <label><input type="checkbox" />Remember me</label>
            <a href="#">Forgot Password?</a>
        </div>

        <button type="submit" class="btnn">Register</button>

        <p>
            Allready have an Account?&ensp;<a href="/login">LogIn</a>
        </p>
    </form>
</div>
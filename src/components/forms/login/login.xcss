@import '../../../styles/global.xcss';


.login-form-container {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: @space-lg;
    min-height: 90vh;

    .login-form {
        padding: @space-xl;
        border-radius: @space-sm;
        box-shadow: @strong-shadow;
        width: 100%;
        max-width: @width-sm;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: @space-md;
        background-color: @light-bg;
        border: 3px solid @white;


        .icon {
            width: @icon-xxxl;
            height: @icon-xxxl;
            background: black;
        }

        h2 {
            margin: 0;
            color: @text-500;
            font-size: 1.5rem;
            margin-bottom: @space-md;
        }

        .input-box {
            width: 100%;
            display: flex;
            flex-direction: column;
            margin-bottom: @space-md;

            input {
                width: 100%;
                .normal-input();
            }
        }

        .remember {
            width: 100%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: @space-md;
            flex-wrap: wrap;

            label {
                display: flex;
                align-items: center;
                gap: @space-xs;

                input[type="checkbox"] {
                    width: @space-md;
                    height: @space-md;
                }
            }

            a {
                color: @accent-600;
                text-decoration: none;
                &:hover {
                    text-decoration: underline;
                }
            }
        }

        .btnn {
            width: 100%;
            padding: @space-sm 0;
            background-color: @accent-600;
            color: @white;
            font-size: 1rem;
            font-weight: bold;
            border: none;
            border-radius: @space-xs;
            cursor: pointer;
            transition: background-color 0.2s ease;
            &:hover {
                background-color: @accent-700;
            }
        }

        p, a {
            font-size: 0.9rem;
            color: @text-400;

            a {
                color: @accent-600;
                text-decoration: none;
                &:hover {
                    text-decoration: underline;
                }
            }
        }
    }
  }

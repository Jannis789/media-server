@import '../../../styles/global.xcss';


.login-form-container {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: @space-lg;
    min-height: 90vh;

    .login-form {
        padding: @space-xl;
        border-radius: @space-sm;
        box-shadow: @strong-shadow;
        width: 100%;
        max-width: @width-sm;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: @space-md;
        background-color: @light-bg;
        border: 3px solid @white;


        .icon {
            width: @icon-xxxl;
            height: @icon-xxxl;
            background: black;
        }

        .input-box {
            width: 100%;
            display: flex;
            gap: @space-xs;
            background: @accent-200;
            border-radius: @space-xs;
            border: 1px solid fade(@dark-400, 30%);
            padding: @space-xxs;

            x-icon {
                .default-icon();
            }

            x-icon.left-symbolic {
                margin: @space-xs 0 @space-xs @space-xs;
            }

            x-icon.right-symbolic {
                margin: @space-xs @space-xs @space-xs 0;
                cursor: pointer;

                &:hover {
                    background: @dark-500;
                }
            }

            @media (max-width: 360px) {
                x-icon.right-symbolic {
                    display: none !important;
                }
            }

            input {
                flex: 1;
                .default-input();
            }
        }

        .remember {
            width: 100%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: @space-md;
            flex-wrap: wrap;

            label {
                display: flex;
                align-items: center;
                gap: @space-xs;

                input[type="checkbox"] {
                    width: @space-md;
                    height: @space-md;
                }
            }

            a {
                color: @accent-600;
                text-decoration: none;
                &:hover {
                    text-decoration: underline;
                }
            }
        }

        button[type="submit"]  {
            width: 100%;
            .default-submit-button();
        }

        p, a {
            font-size: 0.9rem;
            color: @text-400;

            a {
                .hyperlink();
            }
        }
    }
}

x-icon[name='dialog-warning-symbolic'] {
    background: @error-default;
}
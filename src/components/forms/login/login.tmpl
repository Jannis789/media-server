<!DOCTYPE html>

<div class="login-form-container">
    <form class="login-form" @submit.prevent="login()">
        <x-icon name="avatar-default-symbolic" class="icon"></x-icon>
        <h1>Login</h1>
        <hr>
        <div class="input-box">
            <span x-bind:data-tooltip="getErrorMessage('email')">
                <x-icon data-field="email" class="left-symbolic"
                    :name="getErrorMessage('email') !== '' ? 'dialog-warning-symbolic' : 'email-symbolic'">
                </x-icon>
            </span>
            <input type="text" x-model="email" placeholder="Email" required />
        </div>
        <div class="input-box">

            <span x-bind:data-tooltip="getErrorMessage('password')">
                <x-icon data-field="password" class="left-symbolic"
                    :name="getErrorMessage('password') !== '' ? 'dialog-warning-symbolic' : 'password-symbolic'">
                </x-icon>
            </span>

            <input :type="revealPassword ? 'text' : 'password'" x-model="password" id="password" placeholder="Password"
                required autocomplete="new-password" />
            <template x-if="!revealPassword">
                <x-icon class="right-symbolic" name="view-conceal-symbolic" @click="revealPassword = true"></x-icon>
            </template>
            <template x-if="revealPassword">
                <x-icon class="right-symbolic" name="view-reveal-symbolic" @click="revealPassword = false"></x-icon>
            </template>
        </div>
        <div class="remember">
            <label><input type="checkbox" x-model="remember" />Remember me</label>
            <a href="#">Forgot Password?</a>
        </div>
        <button type="submit" x-text="loading ? 'loading...' : 'Login'">Login</button>

        <p>
            Don't have a Account?&ensp;<a href="/register">SignUp</a>
        </p>
    </form>
</div>
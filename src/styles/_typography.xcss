@import './_colors.xcss'; 
// DEFAULT SPACING'S

@space-xxs: 4px;
@space-xs:  8px;
@space-sm:  12px;
@space-md:  16px;
@space-lg:  24px;
@space-xl:  32px;
@space-xxl: 48px;

@width-xs:  400px;
@width-sm:  500px;
@width-md:  600px;
@width-lg:  700px;
@width-xl:  800px;
@width-xxl: 900px;

@icon-xs:  16px;
@icon-sm:  20px;
@icon-md:  24px;
@icon-lg:  32px;
@icon-xl:  40px;
@icon-xxl: 48px;
@icon-xxxl: 64px;
@icon-xxxxl: 80px;

// SHADOWS
@strong-shadow: 0 0 6px fade(@dark-400, 40%);

// FONTS
@font-face {
  font-family: 'primary';
  src: url('/font/AdwaitaSans-Regular.ttf') format('truetype');
  font-weight: normal;
  font-style: normal;
}

input {
    font-size: 1rem;
}

a {
    cursor: pointer;
}

.hyperlink {
    color: @accent-600;
    text-decoration: none;
    &:hover {
        text-decoration: underline;
        color: @accent-800;
    }
}

* {
    font-family: 'primary', sans-serif;
    box-sizing: border-box;
}

@body-padding: 10px max(4px, min(480px, calc(0.2 * 100vw - 115px)));
@content-padding-width: calc(10px + 0.0234 * (100vw - 560px));

body {
    margin: 0;
    padding: @body-padding;
    background-color: @accent-300;
    min-width: 360px;
}

x-body {
    min-width: 320px;
}

hr {
    border: 1px solid fade(@dark-400, 20%);
    width: 100%;
}

// INPUTS ->
.default-input {
    min-width: 120px;
    max-width: 100%;
    border-radius: @space-xs;
    border: 1px solid fade(@dark-400, 30%);
    padding-left: @space-xs;
    box-sizing: border-box;
    min-width: 80px;
}

.default-icon {
    width: @icon-md;
    height: @icon-md;
    background: @dark-400;
}

.default-submit-button {
    padding: @space-sm 0;
    background-color: @accent-600;
    color: @white;
    font-size: 1rem;
    font-weight: bold;
    border: none;
    border-radius: @space-xs;
    cursor: pointer;
    transition: background-color 0.2s ease;
    &:hover {
        background-color: @accent-700;
    }
}

h1 {
    margin: 0 !important;
    color: @text-300;
    margin-bottom: @space-md;
}

.tooltip {
    position: absolute;
    z-index: 1000;
    background: @accent-700;
    color: @white;
    padding: @space-xs @space-sm;
    border-radius: @space-xs;
    box-shadow: 0 2px 8px fade(@dark-400, 30%);
    font-size: 0.95em;
    max-width: 220px;
    white-space: pre-line;
    pointer-events: none;
    margin: 6px;
    transform: translate(calc(-50% + 12px), -100%);
    opacity: 0.95;
    transition: opacity 0.15s;
}

@import './_colors.xcss';
// DEFAULT SPACING'S

@space-xxs: 4px;
@space-xs: 8px;
@space-sm: 12px;
@space-md: 16px;
@space-lg: 24px;
@space-xl: 32px;
@space-xxl: 48px;

@width-xs: 400px;
@width-sm: 500px;
@width-md: 600px;
@width-lg: 700px;
@width-xl: 800px;
@width-xxl: 900px;

@icon-xs: 16px;
@icon-sm: 20px;
@icon-md: 24px;
@icon-lg: 32px;
@icon-xl: 40px;
@icon-xxl: 48px;
@icon-xxxl: 64px;
@icon-xxxxl: 80px;

// SHADOWS
@strong-shadow: 0 0 6px fade(@dark-400, 40%);

// FONTS
@font-face {
    font-family: 'primary';
    src: url('/font/AdwaitaSans-Regular.ttf') format('truetype');
    font-weight: normal;
    font-style: normal;
}

input {
    font-size: 1rem;
}

a {
    cursor: pointer;
}

.hyperlink {
    color: @accent-600;
    text-decoration: none;

    &:hover {
        text-decoration: underline;
        color: @accent-800;
    }
}

* {
    font-family: 'primary', sans-serif;
    box-sizing: border-box;
}

@body-padding: 10px max(4px, min(480px, calc(0.2 * 100vw - 115px)));
@content-padding-width: calc(10px + 0.0234 * (100vw - 560px));

body {
    margin: 0;
    padding: @body-padding;
    background-color: @accent-300;
    min-width: 360px;
}

x-body {
    min-width: 320px;
}

hr {
    border: 1px solid fade(@dark-400, 20%);
    width: 100%;
}

// INPUTS ->
.default-input {
    min-width: 120px;
    max-width: 100%;
    border-radius: @space-xs;
    border: 1px solid fade(@dark-400, 30%);
    padding-left: @space-xs;
    box-sizing: border-box;
    min-width: 80px;
}

.default-icon {
    width: @icon-md;
    height: @icon-md;
    background: @dark-400;
}

.default-submit-button {
    padding: @space-sm 0;
    background-color: @accent-600;
    color: @white;
    font-size: 1rem;
    font-weight: bold;
    border: none;
    border-radius: @space-xs;
    cursor: pointer;
    transition: background-color 0.2s ease;

    &:hover {
        background-color: @accent-700;
    }
}

h1 {
    margin: 0 !important;
    color: @text-300;
    margin-bottom: @space-md;
}

[data-tooltip] {
  position: relative;
  cursor: help;

  &::after {
    content: attr(data-tooltip);
    position: absolute;
    bottom: calc(100% + 6px);
    left: 50%;
    transform: translateX(-50%);
    background-color: @white;
    color: @text-300;
    padding: 6px 10px;
    font-size: 0.75rem;
    border: 1px solid @accent-400;
    border-radius: 6px;
    box-shadow: 0px 3px 3px -2px rgba(0, 0, 0, 0.1),
      0px 3px 4px 0px rgba(0, 0, 0, 0.07),
      0px 1px 8px 0px rgba(0, 0, 0, 0.06);
    backdrop-filter: blur(4px);

    /* Text layout */
    max-width: min(300px, 40vw);
    min-width: 120px;
    width: 380px;
    white-space: pre-line;
    overflow-wrap: break-word;
    word-break: break-word;

    /* Start hidden */
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    z-index: 10;
  }

  &:hover::after {
    opacity: 1;
    visibility: visible;
  }
}
